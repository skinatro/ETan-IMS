//Ver: v2.0

// Enum Definitions
enum user_role {
  admin
  customer
}

enum order_status {
  booked
  accepted
  rejected
  cancelled
  returned
}

enum component_category {
  AC [note: 'Active Components']
  PAS [note: 'Passive Components']
  SEMIC [note: 'Semiconductor Devices']
  PS [note: 'Power Supplies']
  EMECH [note: 'Electromechanical Components']
  SENS [note: 'Sensors']
  MC [note: 'Microcontrollers']
  DLC [note: 'Digital Logic Components']
  COMM [note: 'Communication Modules']
  DISP [note: 'Display Devices']
  SWITCH [note: 'Switches and Protective Devices']
  CONN [note: 'Connectors and Interfacing']
  WIRE [note: 'Wiring and Cables']
  PCB [note: 'PCB and Prototypes']
  MECH [note: 'Mechanical Components']
  TOOL [note: 'Tools and Test Equipment']
  MISC [note: 'Miscellaneous']
}

// Table Definitions
Table user {
  user_id integer [primary key]
  username varchar [not null, unique]
  email varchar [not null, unique]
  password_hash varchar [not null]
  pid integer [unique]
  role user_role [not null, default: 'customer']
  phone_number varchar(10) [unique]
  is_member bool [default: false]
}

Table component {
  component_id integer [primary key]
  name varchar [not null]
  category component_category [not null, default: 'MISC']
  quantity integer [not null, default: 0]
  is_rentable bool [not null, default: true]
  rental_rate integer [not null, default: 0]
  product_image varchar
  datasheet_url varchar
  description text [default: 'Component Specifications here']
  location varchar [not null, default: 'Cupboard']
  created_at timestamp
}

Table order {
  order_id integer [primary key]
  user_id integer [not null]
  status order_status [not null, default: 'booked']
  created_at timestamp [not null]
  decided_at timestamp
  returned_at timestamp
}

Table order_item {
  order_item_id integer [primary key]
  order_id integer [not null]
  component_id integer [not null]
  quantity integer [not null, default: 1]

  indexes {
    (order_id, component_id) [unique]
  }
}

// Relationships
Ref: order.user_id > user.user_id
Ref: order_item.order_id > order.order_id
Ref: order_item.component_id > component.component_id